{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Object",
  "type": "object",
  "required": ["id", "name", "data"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "data": {
      "type": ["object", "null"],
      "properties": {
        "year": { "type": "integer" },
        "price": { "type": "number", "minimum": 0 },
        "CPU model": { "type": "string" },
        "Hard disk size": { "type": "string" },
        "color": { "type": "string" }
      }
    }
  }
}
